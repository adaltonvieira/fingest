generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================================
// ENUMS
// ==========================================================

enum TransactionType {
  RECEITA
  DESPESA
}

enum TransactionStatus {
  PAGO
  RECEBIDO
  PENDENTE
  CANCELADO
}

enum InvoiceStatus {
  ABERTA
  FECHADA
  PAGA
}

enum AccountType {
  CORRENTE
  POUPANCA
  CARTEIRA
  DINHEIRO
  PIX
  INVESTIMENTO
  CRIPTO
  OUTRO
}

// ==========================================================
// USER (single-user hoje, mas modelado para multiusuário futuro)
// ==========================================================

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  twoFactorSecret  String?
  twoFactorEnabled Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts     Account[]
  categories   Category[]
  costCenters  CostCenter[]
  transactions Transaction[]
  refreshTokens RefreshToken[]
  creditCards  CreditCard[]
  recurringRules RecurringRule[]
  goals        Goal[]
  auditLogs    AuditLog[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)

  @@index([userId])
  @@map("refresh_tokens")
}

// ==========================================================
// ACCOUNTS
// ==========================================================

model Account {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  type          AccountType
  initialBalance Decimal    @default(0) @db.Decimal(14, 2)
  currentBalance Decimal    @default(0) @db.Decimal(14, 2)
  color         String?
  icon          String?
  archived      Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  transactions  Transaction[]

  @@index([userId])
  @@map("accounts")
}

// ==========================================================
// COST CENTERS
// ==========================================================

model CostCenter {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String

  transactions Transaction[]

  @@index([userId])
  @@map("cost_centers")
}

// ==========================================================
// CATEGORIES (com subcategorias auto-referenciadas)
// ==========================================================

model Category {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  type        TransactionType
  color       String   @default("#6366F1")
  icon        String   @default("tag")
  description String?

  parentId    String?
  parent      Category?  @relation("CategoryToSubcategory", fields: [parentId], references: [id], onDelete: Cascade)
  subcategories Category[] @relation("CategoryToSubcategory")

  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("categories")
}

// ==========================================================
// TRANSACTIONS (receitas e despesas)
// ==========================================================

model Transaction {
  id          String             @id @default(uuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        TransactionType
  description String
  amount      Decimal            @db.Decimal(14, 2)
  status      TransactionStatus  @default(PENDENTE)

  date        DateTime           // data do lançamento
  dueDate     DateTime?          // vencimento (despesas/receitas a prazo)
  paidAt      DateTime?          // quando foi efetivamente pago/recebido
  competencia DateTime?          // mês de competência contábil

  accountId   String
  account     Account            @relation(fields: [accountId], references: [id])

  categoryId  String?
  category    Category?          @relation(fields: [categoryId], references: [id])

  costCenterId String?
  costCenter  CostCenter?        @relation(fields: [costCenterId], references: [id])

  paymentMethod String?          // pix, dinheiro, cartao, boleto, transferencia
  clientOrSupplier String?       // nome livre do cliente (receita) ou fornecedor (despesa)

  installmentGroupId String?     // agrupa parcelas de um mesmo lançamento
  installmentNumber  Int?        // 1, 2, 3...
  installmentTotal   Int?        // total de parcelas

  notes       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, date])
  @@index([accountId])
  @@index([categoryId])
  @@index([installmentGroupId])
  @@map("transactions")
}

// ==========================================================
// CREDIT CARDS, INVOICES, INVOICE ITEMS
// ==========================================================

model CreditCard {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  bank         String?
  limit        Decimal  @default(0) @db.Decimal(14, 2)
  closingDay   Int      // dia do mês em que a fatura fecha (1-28)
  dueDay       Int      // dia do mês em que a fatura vence (1-28)
  color        String   @default("#4338CA")
  archived     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  invoices     Invoice[]

  @@index([userId])
  @@map("credit_cards")
}

model Invoice {
  id             String        @id @default(uuid())
  creditCardId   String
  creditCard     CreditCard    @relation(fields: [creditCardId], references: [id], onDelete: Cascade)

  referenceMonth DateTime      // primeiro dia do mês de referência da fatura (ex: 2026-08-01)
  closingDate    DateTime
  dueDate        DateTime
  status         InvoiceStatus @default(ABERTA)
  paidAt         DateTime?
  paidTransactionId String?    // referencia a transação de despesa gerada ao pagar a fatura

  items          InvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([creditCardId, referenceMonth])
  @@index([creditCardId])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  description String
  amount      Decimal  @db.Decimal(14, 2)
  date        DateTime
  categoryId  String?

  installmentGroupId String?
  installmentNumber  Int?
  installmentTotal   Int?

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@map("invoice_items")
}

// ==========================================================
// RECURRING RULES (AUTOMAÇÕES)
// ==========================================================

model RecurringRule {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  description String
  amount      Decimal         @db.Decimal(14, 2)
  type        TransactionType
  dayOfMonth  Int             // dia do mês em que o lançamento deve ser gerado (1-28)

  accountId   String
  categoryId  String?
  costCenterId String?
  paymentMethod String?

  active      Boolean         @default(true)
  lastGeneratedMonth DateTime? // primeiro dia do último mês em que já foi gerado (evita duplicar)

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId])
  @@map("recurring_rules")
}

// ==========================================================
// METAS FINANCEIRAS
// ==========================================================

model Goal {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title        String
  targetAmount Decimal  @db.Decimal(14, 2)
  currentAmount Decimal @default(0) @db.Decimal(14, 2)
  deadline     DateTime?
  color        String   @default("#4338CA")
  icon         String   @default("target")
  archived     Boolean  @default(false)

  contributions GoalContribution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("goals")
}

model GoalContribution {
  id        String   @id @default(uuid())
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  amount    Decimal  @db.Decimal(14, 2)
  date      DateTime
  accountId String?  // conta de onde o valor saiu, se debitado (opcional)
  notes     String?

  createdAt DateTime @default(now())

  @@index([goalId])
  @@map("goal_contributions")
}

// ==========================================================
// TRILHA DE AUDITORIA
// ==========================================================

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  action     String   // ex: "CREATE", "UPDATE", "DELETE"
  entity     String   // ex: "Transaction", "Account", "Goal"
  entityId   String?
  description String  // resumo legível, ex: "Criou lançamento 'Aluguel' de R$ 500,00"
  metadata   Json?    // dados extras (antes/depois, etc.)

  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@map("audit_logs")
}
