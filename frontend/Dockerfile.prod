# ---------- Build ----------
FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

# A URL da API precisa ser conhecida NO MOMENTO DO BUILD (o Vite embute isso
# no JavaScript final, não é uma variável de ambiente lida em runtime).
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build

# ---------- Runtime ----------
FROM node:20-alpine

WORKDIR /app

RUN npm install -g serve

COPY --from=builder /app/dist ./dist

# O Railway injeta a variável PORT dinamicamente; o servidor precisa escutar
# nela (não numa porta fixa), por isso usamos "sh -c" para expandir $PORT.
CMD ["sh", "-c", "serve -s dist -l ${PORT:-5173}"]
